# MODELO DE CONFIGURAÇÃO. O arquivo real api-server\.env não integra o ZIP oficial.
# Em atualizações, preserve o .env existente para manter chaves e preferências locais.

# Provedor ativo: gemini ou mistral
AI_PROVIDER=mistral

GEMINI_API_KEY=cole_sua_chave_aqui
GEMINI_MODEL=gemini-3.5-flash

# A segunda chave Mistral é opcional. Quando configurada, funciona como reserva
# para limite temporário, cota ou recusa da primeira chave.
MISTRAL_API_KEY=cole_sua_chave_principal_aqui
MISTRAL_API_KEY_2=
MISTRAL_API_URL=https://api.mistral.ai/v1/chat/completions

# Modelo geral de segurança. As rotas por etapa abaixo prevalecem.
MISTRAL_MODEL=mistral-small-2603

# Roteamento editorial v7.7
MISTRAL_MODEL_THEMES=mistral-small-2603
MISTRAL_MODEL_SCENES45=mistral-large-2512
MISTRAL_MODEL_SCENES916=mistral-large-2512
MISTRAL_MODEL_CAPTION=mistral-large-2512

# Roteamento opcional por categoria. Use somente quando desejar substituir
# todas as etapas da categoria e deixe vazio para respeitar as rotas por etapa.
MISTRAL_MODEL_CREATIVE=
MISTRAL_MODEL_FAST=

PORT=8787
OPEN_BROWSER=0
INKVORTEX_API_PROFILE=adaptive
GEMINI_MAX_OUTPUT_TOKENS=65536
MISTRAL_MAX_OUTPUT_TOKENS=65536
